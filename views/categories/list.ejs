<%- include("../includes/head") %>
<link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <%- include("../includes/navigation") %>


    <main>

        <h1 class="page-title">
            <%= pageTitle %>
        </h1>


        <% if (categories.length === 0) { %>

            <p class="empty-message">
                No categories found.
            </p>


        <% } else { %>


            <div class="table-container">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>


                    <tbody>

                        <% categories.forEach(category => { %>

                            <tr>

                                <td>
                                    <%= category.name %>
                                </td>


                                <td>

                                    <a 
                                        class="btn warning" 
                                        href="/categories/edit/<%= category.id %>"
                                    >
                                        Edit
                                    </a>


                                    <form 
                                        class="inline-form"
                                        action="/categories/delete/<%= category.id %>" 
                                        method="POST"
                                    >

                                        <button 
                                            class="btn danger" 
                                            type="submit"
                                        >
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>


        <% } %>


        <div class="centered">

            <a 
                class="btn success" 
                href="/categories/add"
            >
                + Add Category
            </a>

        </div>


    </main>


    <%- include("../includes/end") %>

</body>
<%- include('../includes/head.ejs') %>

</head>

<body>

<%- include('../includes/navigation.ejs') %>

<main>

    <h1 class="page-title">
        Products
    </h1>

    <% if(products.length > 0) { %>

        <div class="table-container">

            <table class="data-table">

                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                <% products.forEach(product => { %>

                    <tr>

                        <td>
                            <% if(product.imageUrl) { %>

                                <img 
                                    src="<%= product.imageUrl %>" 
                                    alt="<%= product.name %>"
                                    class="product-image"
                                >

                            <% } else { %>

                                No Image

                            <% } %>
                        </td>

                        <td>
                            <%= product.name %>
                        </td>

                        <td>
                            <%= product.sku %>
                        </td>

                        <td>
                            $<%= product.price %>
                        </td>

                        <td>
                            <%= product.stockQuantity %>
                        </td>

                        <td>

                            <a href="/products/<%= product.id %>" class="btn">
                                View
                            </a>

                            <a href="/products/<%= product.id %>/edit" class="btn warning">
                                Edit
                            </a>

                            <form 
                                action="/products/<%= product.id %>/delete"
                                method="POST"
                                class="inline-form">

                                <button class="btn danger">
                                    Delete
                                </button>

                            </form>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    <% } else { %>

        <p class="empty-message">
            No products found.
        </p>

        <div class="centered">
            <a href="/products/create" class="btn success">
                + Add Product
            </a>
        </div>

    <% } %>

</main>

</body>

</html>